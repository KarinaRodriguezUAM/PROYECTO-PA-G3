<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UAM Lab Help Desk</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                background: linear-gradient(135deg,#0f172a 0%,#1e293b 100%);
                font-family: "Segoe UI",sans-serif;
            }

            .login-wrapper {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 30px;
            }

            .login-card {
                width: 100%;
                max-width: 500px;
                background: #fff;
                border-radius: 18px;
                padding: 45px;
                box-shadow: 0 20px 60px rgba(0,0,0,.35);
            }

            .login-brand {
                text-align: center;
                margin-bottom: 30px;
            }

            .login-brand-icon {
                font-size: 60px;
                color: #0f172a;
            }

            .login-form-title {
                text-align: center;
                font-weight: 700;
                margin-bottom: 30px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            .form-control {
                height: 48px;
            }

            .btn-login {
                width: 100%;
                height: 48px;
                background: #0f172a;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-weight: 600;
                transition: .2s;
            }

                .btn-login:hover {
                    background: #1e293b;
                    color: #fff;
                }

            .validation-summary {
                margin-bottom: 20px;
            }

            footer {
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                text-align: center;
                padding: 15px;
                color: rgba(255,255,255,.65);
                font-size: 13px;
            }

    </style>
</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="login-brand">
                <i class="bi bi-headset login-brand-icon"></i>
                <h2>UAM Help Desk</h2>
            </div>

            @RenderBody()

        </div>

    </div>

    <footer>
        © 2026 UAM Lab Help Desk
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>