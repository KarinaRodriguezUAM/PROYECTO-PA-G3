@model Uam.LabHelpDesk.MvcClient.Models.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_LoginLayout";
}

<h2 class="login-form-title">Recuperar Contraseña</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<form asp-action="ForgotPassword" method="post">

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group mb-4">

        <label asp-for="Email" class="form-label">
            <i class="bi bi-envelope"></i>
            Correo Electrónico
        </label>

        <input asp-for="Email"
               class="form-control"
               placeholder="ejemplo@uam.cr" />

        <span asp-validation-for="Email" class="text-danger"></span>

    </div>

    <button type="submit" class="btn btn-login">
        <i class="bi bi-send"></i>
        Enviar Código
    </button>

</form>

<div class="text-center mt-3">
    <a asp-action="Login" style="text-decoration:none;">
        Volver al inicio de sesión
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}