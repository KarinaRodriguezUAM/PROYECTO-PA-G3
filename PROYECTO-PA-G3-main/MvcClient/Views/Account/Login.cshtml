@model Uam.LabHelpDesk.MvcClient.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<h2 class="login-form-title">Iniciar Sesión</h2>

<form asp-controller="Account" asp-action="Login" method="post">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="validation-summary">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="form-group">
        <label asp-for="Email" class="form-label">
            <i class="bi bi-envelope"></i> Correo Electrónico
        </label>
        <input asp-for="Email" class="form-control" placeholder="ejemplo@uam.edu.co" type="email" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="form-label">
            <i class="bi bi-lock"></i> Contraseña
        </label>
        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-login">
        <i class="bi bi-box-arrow-in-right"></i> Entrar
    </button>
</form>

@section Scripts {
    @{
        @* @await Html.RenderPartialAsync("_ValidationScriptsPartial"); *@
    }
}