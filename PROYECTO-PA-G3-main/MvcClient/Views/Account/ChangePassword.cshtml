@model Uam.LabHelpDesk.MvcClient.Models.Auth.ChangePasswordViewModel

@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "_LoginLayout";
}

<h2 class="login-form-title">Cambiar Contraseña</h2>

<form asp-action="ChangePassword" method="post">

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group mb-3">
        <label asp-for="CurrentPassword" class="form-label">
            <i class="bi bi-lock"></i>
            Contraseña Actual
        </label>

        <input asp-for="CurrentPassword"
               class="form-control"
               type="password"
               placeholder="Ingrese su contraseña actual" />

        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NewPassword" class="form-label">
            <i class="bi bi-key"></i>
            Nueva Contraseña
        </label>

        <input asp-for="NewPassword"
               class="form-control"
               type="password"
               placeholder="Ingrese la nueva contraseña" />

        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="ConfirmPassword" class="form-label">
            <i class="bi bi-check-circle"></i>
            Confirmar Contraseña
        </label>

        <input asp-for="ConfirmPassword"
               class="form-control"
               type="password"
               placeholder="Repita la nueva contraseña" />

        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-login">
        <i class="bi bi-arrow-repeat"></i>
        Actualizar Contraseña
    </button>

</form>

<div class="text-center mt-3">
    <a asp-action="Login" style="text-decoration:none;">
        Volver al inicio de sesión
    </a>
</div>