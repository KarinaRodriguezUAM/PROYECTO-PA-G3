@{
    ViewData["Title"] = "Actualizar Estado del Reporte";
}

<div id="alertContainer"></div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0 fw-bold">Actualizar Estado: Pendiente/En Progreso &rarr; Resuelto</h5>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold" id="reportTitle">Cargando reporte...</h5>
                    <p class="text-muted" id="reportDesc"></p>

                    <form id="updateStatusForm" onsubmit="submitForm(event)">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Notas de la Resolución</label>
                            <textarea id="notes" class="form-control" rows="5" maxlength="500" placeholder="Escriba aquí los detalles del trabajo realizado, piezas cambiadas o la solución al problema..." required></textarea>
                            <div class="form-text text-end" id="notesCounter">0 / 500 caracteres</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" onclick="cancel()">Cancelar</button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check2-circle me-1"></i>Resolver Reporte
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const reportId = @ViewBag.Id;

        document.addEventListener("DOMContentLoaded", () => {
            loadReportDetails();

            const notesTextarea = document.getElementById("notes");
            const counterDiv = document.getElementById("notesCounter");
            notesTextarea.addEventListener("input", () => {
                counterDiv.textContent = `${notesTextarea.value.length} / 500 caracteres`;
            });
        });

        function showAlert(type, message) {
            const container = document.getElementById("alertContainer");
            container.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show">
                    ${message}
                    <button class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            window.scrollTo({ top: 0, behavior: "smooth" });
            setTimeout(() => { container.innerHTML = ""; }, 4000);
        }

        async function loadReportDetails() {
            try {
                const response = await fetch(`/FaultReports/GetById?id=${reportId}`);
                if (!response.ok) {
                    showAlert("danger", "No fue posible obtener la información del reporte.");
                    return;
                }
                const data = await response.json();
                const report = data.result;

                document.getElementById("reportTitle").textContent = `#${report.id} - ${report.title}`;
                document.getElementById("reportDesc").textContent = report.description;
            } catch {
                showAlert("danger", "Error al conectar con el servidor.");
            }
        }

        async function submitForm(e) {
            e.preventDefault();
            const notes = document.getElementById("notes").value;

            showLoading("Resolviendo reporte...");
            try {
                const response = await fetch(`/FaultReports/UpdateStatusPost?id=${reportId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ Notes: notes })
                });

                const result = await response.json();

                if (response.ok) {
                    showAlert("success", result.message || "El estado del reporte ha sido actualizado a Resuelto.");
                    setTimeout(() => {
                        window.location = `/FaultReports/Detail/${reportId}`;
                    }, 1500);
                } else {
                    showAlert("danger", result.message || "Error al actualizar el estado.");
                }
            } catch {
                showAlert("danger", "Ocurrió un error al enviar el formulario.");
            } finally {
                hideLoading();
            }
        }

        function cancel() {
            window.location = `/FaultReports/Detail/${reportId}`;
        }
    </script>
}
