@model Uam.LabHelpDesk.MvcClient.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Métricas Operativas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Dashboard de Métricas Operativas
        </h2>
        <p class="text-muted mb-0">Consolidado en tiempo real del parque tecnológico y resolución de averías.</p>
    </div>
</div>

<!-- Tarjetas Resumen -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">Total Reportes</span>
                    <h2 class="fw-bold mb-0 mt-1">@Model.Summary.TotalReports</h2>
                </div>
                <i class="bi bi-journal-text fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-dark opacity-75 small text-uppercase fw-bold">Pendientes</span>
                    <h2 class="fw-bold mb-0 mt-1">@Model.Summary.PendingCount</h2>
                </div>
                <i class="bi bi-clock-history fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">En Progreso</span>
                    <h2 class="fw-bold mb-0 mt-1">@Model.Summary.InProgressCount</h2>
                </div>
                <i class="bi bi-gear-wide-connected fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">Resueltos</span>
                    <h2 class="fw-bold mb-0 mt-1">@Model.Summary.ResolvedCount</h2>
                </div>
                <i class="bi bi-check-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-secondary text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">Cerrados</span>
                    <h3 class="fw-bold mb-0 mt-1">@Model.Summary.ClosedCount</h3>
                </div>
                <i class="bi bi-lock-fill fs-2 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-dark text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">Total Equipos</span>
                    <h3 class="fw-bold mb-0 mt-1">@Model.Summary.TotalEquipment</h3>
                </div>
                <i class="bi bi-pc-display fs-2 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-danger text-white h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 small text-uppercase fw-bold">Equipos en Reparación</span>
                    <h3 class="fw-bold mb-0 mt-1">@Model.Summary.EquipmentUnderRepair</h3>
                </div>
                <i class="bi bi-tools fs-2 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Indicador de Tiempo Promedio de Resolución -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-speedometer text-primary me-2"></i>Tiempos Operativos de Resolución
        </h5>
    </div>
    <div class="card-body">
        <div class="row text-center g-3">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small text-uppercase fw-bold">Tiempo Promedio</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.ResolutionTime.AverageHours <small class="fs-6 text-muted">hrs</small></h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small text-uppercase fw-bold">Resolución Más Rápida</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.ResolutionTime.FastestResolutionHours <small class="fs-6 text-muted">hrs</small></h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small text-uppercase fw-bold">Resolución Más Lenta</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@Model.ResolutionTime.SlowestResolutionHours <small class="fs-6 text-muted">hrs</small></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tablas de Laboratorios y Técnicos -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-building text-primary me-2"></i>Reportes por Laboratorio
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Laboratorio</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Pendientes</th>
                                <th class="text-center">En Progreso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReportsByLab.Any())
                            {
                                foreach (var lab in Model.ReportsByLab)
                                {
                                    <tr>
                                        <td class="fw-semibold">@lab.LabName</td>
                                        <td class="text-center"><span class="badge bg-primary rounded-pill">@lab.TotalReports</span></td>
                                        <td class="text-center"><span class="badge bg-warning text-dark rounded-pill">@lab.PendingCount</span></td>
                                        <td class="text-center"><span class="badge bg-info rounded-pill">@lab.InProgressCount</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No hay datos de laboratorios disponibles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-people text-primary me-2"></i>Carga de Trabajo por Técnico
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Técnico</th>
                                <th class="text-center">Asignados (En Progreso)</th>
                                <th class="text-center">Histórico Resueltos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReportsByTechnician.Any())
                            {
                                foreach (var tech in Model.ReportsByTechnician)
                                {
                                    <tr>
                                        <td class="fw-semibold">@tech.FullName</td>
                                        <td class="text-center"><span class="badge bg-info rounded-pill fs-6 px-3">@tech.AssignedCount</span></td>
                                        <td class="text-center"><span class="badge bg-success rounded-pill fs-6 px-3">@tech.ResolvedCount</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">No hay técnicos activos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
