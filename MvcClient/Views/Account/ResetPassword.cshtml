@model Uam.LabHelpDesk.MvcClient.Models.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_LoginLayout";
}

<h2 class="login-form-title">Restablecer Contraseña</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<form asp-action="ResetPassword" method="post">

    <input type="hidden" asp-for="SessionToken" />

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group mb-3">

        <label asp-for="Code" class="form-label">
            Código OTP
        </label>

        <input asp-for="Code"
               class="form-control text-center"
               maxlength="6"
               placeholder="000000" />

        <span asp-validation-for="Code" class="text-danger"></span>

    </div>

    <div class="form-group mb-3">

        <label asp-for="NewPassword" class="form-label">
            Nueva Contraseña
        </label>

        <input asp-for="NewPassword"
               class="form-control"
               type="password" />

        <span asp-validation-for="NewPassword" class="text-danger"></span>

    </div>

    <div class="form-group mb-4">

        <label asp-for="ConfirmPassword" class="form-label">
            Confirmar Contraseña
        </label>

        <input asp-for="ConfirmPassword"
               class="form-control"
               type="password" />

        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

    </div>

    <button type="submit" class="btn btn-login">
        Cambiar Contraseña
    </button>

</form>